# Copy this file to .env.local and fill it in. Both keys are optional: you
# can also paste them into the app's Settings panel, or skip them and use
# the built-in sample prototype, which makes no network calls.
#
# These are bundled into the page, so only use them on your own machine.
# Never deploy a build made with real keys.

# https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# Figma > Settings > Security > Personal access tokens (File content: read)
VITE_FIGMA_TOKEN=

# Optional. Defaults to gemini-2.5-flash.
VITE_GEMINI_MODEL=
